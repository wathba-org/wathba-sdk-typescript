{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expectedSourcePin": {
      "additionalProperties": false,
      "properties": {
        "catalogDefinitionId": {
          "pattern": "^catdef_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "catalogDefinitionVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "catalogReleaseId": {
          "pattern": "^catrel_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "catalogReleaseVersion": {
          "maxLength": 80,
          "minLength": 3,
          "type": "string"
        },
        "skill": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "skillId": {
              "pattern": "^wathba\\.skills\\.[a-z0-9-]+$",
              "type": "string"
            },
            "skillVersion": {
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            }
          },
          "required": [
            "skillId",
            "skillVersion",
            "digest"
          ],
          "type": "object"
        }
      },
      "required": [
        "catalogReleaseId",
        "catalogReleaseVersion",
        "catalogDefinitionId",
        "catalogDefinitionVersion",
        "skill"
      ],
      "type": "object"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    },
    "sourceEnvironmentId": {
      "maxLength": 160,
      "minLength": 3,
      "type": "string"
    },
    "targetPin": {
      "additionalProperties": false,
      "properties": {
        "catalogDefinitionId": {
          "pattern": "^catdef_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "catalogDefinitionVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "catalogReleaseId": {
          "pattern": "^catrel_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "catalogReleaseVersion": {
          "maxLength": 80,
          "minLength": 3,
          "type": "string"
        },
        "skill": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "skillId": {
              "pattern": "^wathba\\.skills\\.[a-z0-9-]+$",
              "type": "string"
            },
            "skillVersion": {
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            }
          },
          "required": [
            "skillId",
            "skillVersion",
            "digest"
          ],
          "type": "object"
        }
      },
      "required": [
        "catalogReleaseId",
        "catalogReleaseVersion",
        "catalogDefinitionId",
        "catalogDefinitionVersion",
        "skill"
      ],
      "type": "object"
    }
  },
  "required": [
    "protocolVersion",
    "sourceEnvironmentId",
    "expectedSourcePin",
    "targetPin"
  ],
  "type": "object"
}
