{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assembledReleaseId": {
      "pattern": "^arel_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "assembledReleaseVersion": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "capabilityCode": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "type": "string"
    },
    "catalogDefinitionId": {
      "pattern": "^catdef_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "catalogDefinitionVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "catalogReleaseId": {
      "pattern": "^catrel_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "catalogReleaseVersion": {
      "maxLength": 80,
      "minLength": 3,
      "type": "string"
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "agentHosts": {
          "items": {
            "const": "codex",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cliProtocol": {
          "const": "1.0",
          "type": "string"
        },
        "cliVersion": {
          "maxLength": 80,
          "minLength": 3,
          "type": "string"
        },
        "sdkVersion": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "cliProtocol",
        "cliVersion",
        "sdkVersion",
        "agentHosts"
      ],
      "type": "object"
    },
    "integrationManifestId": {
      "pattern": "^cim_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "serviceCode": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "type": "string"
    },
    "skillId": {
      "pattern": "^wathba\\.skills\\.[a-z0-9-]+$",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "skillId",
    "version",
    "serviceCode",
    "capabilityCode",
    "assembledReleaseId",
    "assembledReleaseVersion",
    "catalogReleaseId",
    "catalogReleaseVersion",
    "catalogDefinitionId",
    "catalogDefinitionVersion",
    "integrationManifestId",
    "compatibility"
  ],
  "type": "object"
}
