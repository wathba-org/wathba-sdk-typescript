{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "approve",
        "deny",
        "cancel"
      ],
      "type": "string"
    },
    "expectedSourceVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "decision",
    "expectedSourceVersion"
  ],
  "type": "object"
}
