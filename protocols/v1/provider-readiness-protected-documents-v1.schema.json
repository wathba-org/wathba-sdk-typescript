{
  "$id": "wathba://schemas/provider-readiness/protected-documents.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "documents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "handle": {
                "pattern": "^pp_[A-Za-z0-9._:-]+$",
                "type": "string"
              }
            },
            "required": [
              "handle",
              "digest"
            ],
            "type": "object"
          },
          "documentCategory": {
            "enum": [
              "commercial_registration",
              "beneficial_owner_identity",
              "bank_account_evidence",
              "tax_registration",
              "operating_license",
              "other"
            ],
            "type": "string"
          },
          "mimeType": {
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ],
            "type": "string"
          }
        },
        "required": [
          "documentCategory",
          "content",
          "mimeType"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "documents"
  ],
  "type": "object"
}
