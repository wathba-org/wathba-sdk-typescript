{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "approve",
            "deny",
            "cancel",
            "acknowledge"
          ],
          "type": "string"
        },
        "expectedSourceVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "protocolVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "decision",
        "expectedSourceVersion"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "submit",
          "type": "string"
        },
        "expectedSourceVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "protectedInput": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "handle": {
              "pattern": "^pp_[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            "schemaRef": {
              "additionalProperties": false,
              "properties": {
                "digest": {
                  "pattern": "^sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "schemaRef": {
                  "pattern": "^wathba:\\/\\/schemas\\/[a-z0-9./_-]+$",
                  "type": "string"
                },
                "version": {
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991,
                  "type": "integer"
                }
              },
              "required": [
                "schemaRef",
                "version",
                "digest"
              ],
              "type": "object"
            }
          },
          "required": [
            "handle",
            "digest",
            "schemaRef"
          ],
          "type": "object"
        },
        "protocolVersion": {
          "const": "1.0",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "decision",
        "expectedSourceVersion",
        "protectedInput"
      ],
      "type": "object"
    }
  ]
}
