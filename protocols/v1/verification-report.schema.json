{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilityCode": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "type": "string"
    },
    "facts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "automaticRepairAllowed": {
            "type": "boolean"
          },
          "checkId": {
            "pattern": "^[a-z][a-z0-9_.-]{2,159}$",
            "type": "string"
          },
          "checkVersion": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "correlationId": {
            "pattern": "^corr_[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "freshness": {
            "enum": [
              "current",
              "stale",
              "unknown"
            ],
            "type": "string"
          },
          "observedAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "action_required",
              "pending",
              "skipped"
            ],
            "type": "string"
          },
          "owner": {
            "enum": [
              "member_accounts",
              "application_access_and_keys",
              "provider_connections",
              "projects",
              "verification",
              "billing_wallet",
              "budget_controls",
              "member_notifications",
              "service_catalog"
            ],
            "type": "string"
          },
          "protectedEvidence": {
            "additionalProperties": false,
            "properties": {
              "classification": {
                "enum": [
                  "member_safe",
                  "restricted",
                  "partner_confidential"
                ],
                "type": "string"
              },
              "digest": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "handle": {
                "maxLength": 240,
                "minLength": 3,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
                "type": "string"
              }
            },
            "required": [
              "handle",
              "digest",
              "classification"
            ],
            "type": "object"
          },
          "remediationCode": {
            "pattern": "^[a-z][a-z0-9_]{2,127}$",
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "retryable": {
            "type": "boolean"
          },
          "sourceRef": {
            "maxLength": 240,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
            "type": "string"
          },
          "sourceVersion": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "summaryKey": {
            "maxLength": 160,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "checkId",
          "checkVersion",
          "required",
          "outcome",
          "owner",
          "sourceRef",
          "sourceVersion",
          "freshness",
          "observedAt",
          "expiresAt",
          "summaryKey",
          "retryable",
          "automaticRepairAllowed",
          "correlationId"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "generatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    },
    "reportId": {
      "maxLength": 160,
      "minLength": 3,
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "reportId",
    "capabilityCode",
    "generatedAt",
    "facts"
  ],
  "type": "object"
}
