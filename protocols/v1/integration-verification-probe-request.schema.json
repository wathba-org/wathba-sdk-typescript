{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": [
        "local_mock_contract",
        "real_sandbox_send"
      ],
      "type": "string"
    },
    "profileId": {
      "maxLength": 240,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
      "type": "string"
    },
    "profileVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "profileId",
    "profileVersion",
    "mode"
  ],
  "type": "object"
}
