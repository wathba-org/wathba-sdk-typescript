{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expectedSourceVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "input": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contact": {
              "additionalProperties": false,
              "properties": {
                "email": {
                  "format": "email",
                  "maxLength": 254,
                  "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                  "type": "string"
                },
                "fullName": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "phoneE164": {
                  "pattern": "^\\+[1-9]\\d{7,14}$",
                  "type": "string"
                }
              },
              "required": [
                "fullName",
                "email",
                "phoneE164"
              ],
              "type": "object"
            },
            "countryCode": {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            "legalEntityType": {
              "enum": [
                "company",
                "sole_proprietorship",
                "nonprofit",
                "government_entity"
              ],
              "type": "string"
            },
            "protocolVersion": {
              "const": "1.0",
              "type": "string"
            },
            "registeredName": {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            "registrationNumber": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            "taxNumber": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "protocolVersion",
            "legalEntityType",
            "countryCode",
            "registeredName",
            "registrationNumber",
            "contact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "documents": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "additionalProperties": false,
                    "properties": {
                      "digest": {
                        "pattern": "^sha256:[a-f0-9]{64}$",
                        "type": "string"
                      },
                      "handle": {
                        "pattern": "^pp_[A-Za-z0-9._:-]+$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "handle",
                      "digest"
                    ],
                    "type": "object"
                  },
                  "documentCategory": {
                    "enum": [
                      "commercial_registration",
                      "beneficial_owner_identity",
                      "bank_account_evidence",
                      "tax_registration",
                      "operating_license",
                      "other"
                    ],
                    "type": "string"
                  },
                  "mimeType": {
                    "enum": [
                      "application/pdf",
                      "image/jpeg",
                      "image/png"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "documentCategory",
                  "content",
                  "mimeType"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array"
            },
            "protocolVersion": {
              "const": "1.0",
              "type": "string"
            }
          },
          "required": [
            "protocolVersion",
            "documents"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "administrativeArea": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            "contact": {
              "additionalProperties": false,
              "properties": {
                "fullName": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "phoneE164": {
                  "pattern": "^\\+[1-9]\\d{7,14}$",
                  "type": "string"
                }
              },
              "required": [
                "fullName",
                "phoneE164"
              ],
              "type": "object"
            },
            "countryCode": {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            "line1": {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            "line2": {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            "locality": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            "postalCode": {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            "protocolVersion": {
              "const": "1.0",
              "type": "string"
            }
          },
          "required": [
            "protocolVersion",
            "countryCode",
            "administrativeArea",
            "locality",
            "line1"
          ],
          "type": "object"
        }
      ]
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    },
    "schemaRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaRef": {
          "pattern": "^wathba:\\/\\/schemas\\/[a-z0-9./_-]+$",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "schemaRef",
        "version",
        "digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "protocolVersion",
    "expectedSourceVersion",
    "schemaRef",
    "input"
  ],
  "type": "object"
}
