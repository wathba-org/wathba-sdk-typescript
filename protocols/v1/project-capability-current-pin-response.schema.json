{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bindingId": {
      "pattern": "^svb_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "bindingOwnerVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "bindingStatus": {
      "enum": [
        "active",
        "removed"
      ],
      "type": "string"
    },
    "capabilityCode": {
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "type": "string"
    },
    "currentPin": {
      "additionalProperties": false,
      "properties": {
        "catalogDefinitionId": {
          "pattern": "^catdef_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "catalogDefinitionVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "catalogReleaseId": {
          "pattern": "^catrel_[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "catalogReleaseVersion": {
          "maxLength": 80,
          "minLength": 3,
          "type": "string"
        },
        "skill": {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "skillId": {
              "pattern": "^wathba\\.skills\\.[a-z0-9-]+$",
              "type": "string"
            },
            "skillVersion": {
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            }
          },
          "required": [
            "skillId",
            "skillVersion",
            "digest"
          ],
          "type": "object"
        }
      },
      "required": [
        "catalogReleaseId",
        "catalogReleaseVersion",
        "catalogDefinitionId",
        "catalogDefinitionVersion",
        "skill"
      ],
      "type": "object"
    },
    "currentSnapshotId": {
      "pattern": "^acts_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "environmentId": {
      "pattern": "^env_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "projectId": {
      "pattern": "^prj_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    },
    "sourceRef": {
      "pattern": "^svb_[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "sourceVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "projectId",
    "environmentId",
    "capabilityCode",
    "bindingId",
    "bindingStatus",
    "bindingOwnerVersion",
    "currentSnapshotId",
    "currentPin",
    "sourceRef",
    "sourceVersion",
    "updatedAt"
  ],
  "type": "object"
}
