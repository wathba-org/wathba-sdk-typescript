{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expectedOwnerVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    },
    "reasonCode": {
      "enum": [
        "member_requested",
        "project_capability_removed",
        "credential_compromised",
        "destination_revoked",
        "policy_changed"
      ],
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "expectedOwnerVersion",
    "reasonCode"
  ],
  "type": "object"
}
