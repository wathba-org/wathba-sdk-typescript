{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "facts": {
      "additionalProperties": false,
      "properties": {
        "availableMinor": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "capabilityCode": {
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "environmentId": {
          "maxLength": 160,
          "minLength": 3,
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ],
          "type": "string"
        },
        "heldMinor": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "funded",
            "insufficient",
            "unknown"
          ],
          "type": "string"
        },
        "ownerRef": {
          "maxLength": 240,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "ownerVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "projectId": {
          "maxLength": 160,
          "minLength": 3,
          "type": "string"
        },
        "sourceRef": {
          "maxLength": 240,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "sourceVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "projectId",
        "environmentId",
        "capabilityCode",
        "outcome",
        "currency",
        "availableMinor",
        "heldMinor",
        "ownerRef",
        "ownerVersion",
        "sourceRef",
        "sourceVersion",
        "observedAt",
        "expiresAt",
        "freshness"
      ],
      "type": "object"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "facts"
  ],
  "type": "object"
}
