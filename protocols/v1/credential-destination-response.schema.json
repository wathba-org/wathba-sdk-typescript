{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "destination": {
      "additionalProperties": false,
      "properties": {
        "authorityPolicyVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "canonicalTargetRef": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "certification": {
          "additionalProperties": false,
          "properties": {
            "evidenceRef": {
              "maxLength": 200,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
              "type": "string"
            },
            "expiresAt": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
              "type": "string"
            },
            "proofVersion": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "status": {
              "enum": [
                "pending",
                "current",
                "failed",
                "expired",
                "revoked"
              ],
              "type": "string"
            }
          },
          "required": [
            "status",
            "proofVersion"
          ],
          "type": "object"
        },
        "createdAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "destinationId": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "displayName": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "environmentId": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "gcp_secret_manager",
            "external_authenticated_probe"
          ],
          "type": "string"
        },
        "ownerVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "projectId": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "proofVersion": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "residency": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "automatic",
                  "type": "string"
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "locations": {
                  "items": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 20,
                  "minItems": 1,
                  "type": "array"
                },
                "mode": {
                  "const": "user_managed",
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "locations"
              ],
              "type": "object"
            }
          ]
        },
        "runnerRef": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "runtimePrincipal": {
          "pattern": "^serviceAccount:[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$",
          "type": "string"
        },
        "sourceVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "state": {
          "enum": [
            "requested",
            "awaiting_authorization",
            "certification_pending",
            "authorized",
            "disabled",
            "revocation_pending",
            "denied",
            "expired",
            "revoked"
          ],
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
          "type": "string"
        },
        "writerPrincipal": {
          "pattern": "^serviceAccount:[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$",
          "type": "string"
        }
      },
      "required": [
        "destinationId",
        "projectId",
        "environmentId",
        "kind",
        "displayName",
        "canonicalTargetRef",
        "state",
        "ownerVersion",
        "authorityPolicyVersion",
        "proofVersion",
        "sourceVersion",
        "certification",
        "createdAt",
        "updatedAt"
      ],
      "type": "object"
    },
    "protocolVersion": {
      "const": "1.0",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "destination"
  ],
  "type": "object"
}
