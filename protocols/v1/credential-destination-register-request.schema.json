{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "expectedAuthorityPolicyVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "expectedResidency": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "automatic",
                  "type": "string"
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "locations": {
                  "items": {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  "maxItems": 20,
                  "minItems": 1,
                  "type": "array"
                },
                "mode": {
                  "const": "user_managed",
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "locations"
              ],
              "type": "object"
            }
          ]
        },
        "kind": {
          "const": "gcp_secret_manager",
          "type": "string"
        },
        "protocolVersion": {
          "const": "1.0",
          "type": "string"
        },
        "runtimePrincipal": {
          "pattern": "^serviceAccount:[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$",
          "type": "string"
        },
        "secretResource": {
          "pattern": "^projects\\/[A-Za-z0-9._-]+\\/secrets\\/[A-Za-z0-9_-]+$",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "kind",
        "displayName",
        "secretResource",
        "runtimePrincipal",
        "expectedResidency",
        "expectedAuthorityPolicyVersion"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "expectedAuthorityPolicyVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "kind": {
          "const": "external_authenticated_probe",
          "type": "string"
        },
        "protocolVersion": {
          "const": "1.0",
          "type": "string"
        },
        "runnerRef": {
          "maxLength": 200,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "kind",
        "displayName",
        "runnerRef",
        "expectedAuthorityPolicyVersion"
      ],
      "type": "object"
    }
  ]
}
